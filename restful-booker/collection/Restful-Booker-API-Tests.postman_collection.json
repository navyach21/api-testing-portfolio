        {
          "name": "Get booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n//Verifying booking details are correct at one time\r\npm.test(\"Booking details are correct\", () => {\r\n  const booking = pm.response.json();\r\n  pm.expect(booking.firstname).to.eql(\"Navya\");\r\n  pm.expect(booking.lastname).to.eql(\"C H\");\r\n  pm.expect(booking.totalprice).to.eql(5000);\r\n  pm.expect(booking.depositpaid).to.eql(true);\r\n  pm.expect(booking.bookingdates.checkin).to.eql(\"2026-11-01\");\r\n  pm.expect(booking.bookingdates.checkout).to.eql(\"2026-11-05\");\r\n  pm.expect(booking.additionalneeds).to.eql(\"Breakfast\");\r\n});\r\n\r\n//Verifying the data types of the fields in the response.\r\npm.test(\"Field data types are correct\", () => {\r\n  const booking = pm.response.json();\r\n  pm.expect(booking.firstname).to.be.a(\"string\");\r\n  pm.expect(booking.totalprice).to.be.a(\"number\");\r\n  pm.expect(booking.depositpaid).to.be.a(\"boolean\");\r\n  pm.expect(booking.bookingdates).to.be.an(\"object\");\r\n});\r\n\r\npm.test(\"Response has all expected fields\", () => {\r\n  pm.expect(pm.response.json()).to.have.all.keys(\r\n    \"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\"\r\n  );\r\n});"
                ]
