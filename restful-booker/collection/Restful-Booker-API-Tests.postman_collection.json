      "name": "Booking CRUD",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\",()=>\r\n{\r\n    pm.expect(pm.response.code).to.eql(200);\r\n});\r\n\r\npm.test(\"Booking id is returned and saved\", () => {\r\n  const bookingId = pm.response.json().bookingid;\r\n  pm.expect(bookingId).to.be.a(\"number\");\r\n  pm.environment.set(\"bookingId\", bookingId);\r\n});\r\n\r\npm.test(\"Booking ID is not null\", () =>{\r\n    pm.expect(pm.response.json().bookingid).to.not.eql(null);\r\n});\r\n\r\npm.test(\"Booking id is a positive number\", () => {\r\n    pm.expect(pm.response.json().bookingid).to.be.above(0);\r\n  });\r\n\r\npm.test(\"Check the firstname of the booking\", () =>\r\n{\r\n    pm.expect(pm.response.json().booking.firstname).to.eql(\"Navya\");\r\n});\r\n\r\npm.test(\"Check the lastname of the booking\",() =>\r\n{\r\n    pm.expect(pm.response.json().booking.lastname).to.eql(\"C H\");\r\n});\r\n\r\npm.test(\"Check the total price\",()=>\r\n{\r\n    pm.expect(pm.response.json().booking.totalprice).to.eql(5000);\r\n});\r\n\r\npm.test(\"Check status of depositpaid\",()=>\r\n{\r\n    pm.expect(pm.response.json().booking.depositpaid).to.eql(true);\r\n});\r\n\r\npm.test(\"Check check in and check out dates\",()=>\r\n{\r\n    pm.expect(pm.response.json().booking.bookingdates.checkin).to.eql(\"2026-11-01\");\r\n    pm.expect(pm.response.json().booking.bookingdates.checkout).to.eql(\"2026-11-05\");\r\n});\r\n\r\npm.test(\"Check additional needs\",()=>\r\n{\r\npm.expect(pm.response.json().booking.additionalneeds).to.eql(\"Breakfast\");\r\n});"
                ]
              }
            }
          ],
